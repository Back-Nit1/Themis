# Runtime mode. Local mode makes no paid/external calls.
THEMIS_MODE=local

# AWS/CDK deployment target. Credentials use the standard AWS credential chain.
AWS_REGION=us-east-1
CDK_DEFAULT_REGION=us-east-1
CDK_DEFAULT_ACCOUNT=

# Product capabilities.
ENABLE_RCS=false
ENABLE_SMS_FALLBACK=true
ENABLE_SES=true
ENABLE_BROWSER_RESEARCH=false
# Separate change-control acknowledgement required before Browser IAM can be granted.
BROWSER_RESEARCH_APPROVED=false
ENABLE_PROACTIVE_DETECTION=false
ENABLE_REASONING_ESCALATION=true
THEMIS_STRUCTURED_TOOLS=true

# Merchant profile cache/research. The deployed tools adapter injects MERCHANTS_TABLE.
MERCHANT_STORE=memory
MERCHANT_PROFILE_TTL_SECONDS=604800
MERCHANT_RESEARCH_ENABLED=false
# Must also be true; disabled providers fail closed and stale cache is retained.
MERCHANT_RESEARCH_APPROVED=false
# MERCHANT_RESEARCH_DOMAINS=example.com
# MERCHANT_RESEARCH_MAX_PAGES=3
# MERCHANT_RESEARCH_TIMEOUT_SECONDS=10

# Required before deploying with THEMIS_MODE=aws.
BEDROCK_MODEL_ID_FAST=
BEDROCK_MODEL_ID_REASONING=

# Deterministic policy thresholds shared by Cedar and bank-tools.
DEMO_AUTONOMOUS_CREDIT_LIMIT=50
DEMO_CREDIT_CONFIDENCE_THRESHOLD=0.8

# Agent workflow confidence below this value escalates for human review.
THEMIS_ESCALATION_CONFIDENCE=0.7

# Messaging identities. Provision/verify these manually before live messaging.
# Each is required only when its capability above is enabled; a disabled
# transport does not require an identifier and never constructs its client.
THEMIS_RCS_POOL_ID=   # required when ENABLE_RCS=true
THEMIS_SMS_IDENTITY=  # required when ENABLE_SMS_FALLBACK=true
THEMIS_SES_FROM=      # required when ENABLE_SES=true
THEMIS_SUPPORT=       # required when ENABLE_SES=true
SES_SENDER_DOMAIN=themis-demo.example

# Optional: sender phone -> customerId JSON list for the agent (defaults to the bundled synthetic customers.json).
# THEMIS_CUSTOMER_DIRECTORY=

# CDK injects these into Lambda, AgentCore, and Amplify at deployment.
# Do not normally set them by hand.
# TRANSACTIONS_TABLE=
# CASES_TABLE=
# MERCHANTS_TABLE=
# AUDIT_TABLE=
# IDEMPOTENCY_TABLE=
# ARTIFACTS_BUCKET=
# MESSAGING_FUNCTION_NAME=
# THEMIS_RCS_TOPIC_ARN=
# THEMIS_SMS_TOPIC_ARN=
# THEMIS_DELIVERY_EVENT_TOPIC_ARN=
# ACTIVE_MENU_TABLE=
# AGENT_RUNTIME_ARN=
# AGENT_RUNTIME_QUALIFIER=
# GATEWAY_IDENTIFIER=
# GATEWAY_URL=
# MEMORY_ID=

# Dashboard data source: fixtures (default) or aws (server-side DynamoDB/S3 reads; needs table/bucket vars above).
THEMIS_DASHBOARD_DATA_SOURCE=fixtures

# Claim reconciler bounds (defaults shown; Lambda env overrides these).
RECONCILE_STALE_SECONDS=300
RECONCILE_LEASE_SECONDS=240
RECONCILE_BATCH_SIZE=25
RECONCILE_MAX_ATTEMPTS=3
RECONCILE_BUDGET_SECONDS=40
