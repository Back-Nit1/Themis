{
  "name": "@themis/infra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm --prefix ../services/messaging run build && tsc -p tsconfig.json && python3 ../scripts/build_assets.py",
    "synth": "npm run build && cdk synth",
    "test": "npm run build && node --test test/*.test.mjs",
    "package:aws": "npm run build && python3 ../scripts/build_assets.py --with-boto3",
    "preflight": "node dist/bin/preflight.js",
    "deploy:aws": "npm run synth && npm run package:aws && npm run preflight && cdk deploy --all"
  },
  "dependencies": {
    "aws-cdk-lib": "2.270.0",
    "constructs": "^10.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "aws-cdk": "2.1142.0",
    "typescript": "5.9.2"
  }
}
